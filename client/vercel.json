{
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix ../server --omit=dev",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/assets/**"
    }
  }
}
